#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

needs_validate=0
needs_generated_check=0

for file in $(git diff --cached --name-only); do
  case "$file" in
    data/*)
      needs_validate=1
      case "$file" in
        data/servers.json|data/categories.json) needs_generated_check=1 ;;
      esac
      ;;
  esac
done

if [ "$needs_validate" = 1 ]; then
  node scripts/validate-data.mjs
fi

if [ "$needs_generated_check" = 1 ]; then
  node scripts/generate-readme.mjs --check
fi
