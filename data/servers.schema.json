{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpHQ/awesome-mcp-servers/blob/main/data/servers.schema.json",
  "title": "Awesome MCP Servers catalog",
  "type": "array",
  "minItems": 75,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "url",
      "description",
      "category",
      "language",
      "provider",
      "tags",
      "official"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "maxLength": 240
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "language": {
        "enum": [
          "C",
          "C#",
          "C++",
          "Dart",
          "Elixir",
          "GDScript",
          "Go",
          "Java",
          "JavaScript",
          "Kotlin",
          "Other",
          "PHP",
          "Python",
          "Ruby",
          "Rust",
          "Swift",
          "TypeScript",
          "Zig"
        ]
      },
      "provider": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "official": {
        "type": "boolean"
      },
      "repository": {
        "description": "Source repository. Set this when url is a docs or marketing page, and whenever a GitHub repo can be identified. Omit if the source is unknown.",
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 300
      },
      "license": {
        "description": "SPDX id, or source-available / proprietary. Omit unless the project states it.",
        "enum": [
          "MIT",
          "Apache-2.0",
          "BSD-2-Clause",
          "BSD-3-Clause",
          "ISC",
          "MPL-2.0",
          "GPL-3.0",
          "AGPL-3.0",
          "Unlicense",
          "source-available",
          "proprietary"
        ]
      },
      "pricing": {
        "description": "What it costs to use the server. Omit unless the project states it.",
        "enum": ["free", "freemium", "paid"]
      },
      "transport": {
        "description": "How a client runs the server. A server may support more than one.",
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "enum": ["stdio", "streamable-http", "sse"]
        }
      },
      "install": {
        "description": "Package a local client can run. Omit unless the package name is known.",
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "package"],
        "properties": {
          "command": {
            "enum": ["npx", "uvx", "docker", "pip", "uv", "cargo", "go"]
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S+$"
          }
        }
      },
      "auth": {
        "description": "How a client authenticates. none means a usable path needs no credential. Omit unless stated.",
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "enum": ["none", "api-key", "oauth"]
        }
      },
      "verified": {
        "description": "UTC date a reviewer last confirmed the server is still maintained. Do not guess.",
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "order": {
        "type": "integer",
        "minimum": 0
      },
      "endpoints": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "sse": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "streamableHttp": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    }
  }
}
