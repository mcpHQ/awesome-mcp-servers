{
  "name": "awesome-mcp-servers",
  "private": true,
  "type": "module",
  "description": "A curated catalog of Model Context Protocol (MCP) servers",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "validate": "node scripts/validate-data.mjs",
    "generate": "node scripts/generate-readme.mjs && node scripts/generate-llms.mjs",
    "check-generated": "node scripts/generate-readme.mjs --check && node scripts/generate-llms.mjs --check",
    "fetch-logos": "node scripts/fetch-logos.mjs",
    "build-site": "node scripts/build-site.mjs",
    "serve-site": "node scripts/serve-site.mjs",
    "dev": "node scripts/build-site.mjs && node scripts/serve-site.mjs",
    "check-links": "node scripts/check-links.mjs",
    "install-hooks": "node scripts/install-hooks.mjs"
  }
}
